<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.paint.Color?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="800.0" prefWidth="986.0" xmlns="http://javafx.com/javafx/25.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Admin.AdminManagerPartController">
   <children>
      <MenuBar layoutX="-1.0" prefHeight="26.0" prefWidth="986.0">
         <menus>
            <Menu mnemonicParsing="false" text="File">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#getManagerInformation" text="Read information" />
                  <MenuItem mnemonicParsing="false" onAction="#backToManager" text="Back to manager" />
                  <MenuItem mnemonicParsing="false" onAction="#backToAdmin" text="Back to admin" />
                  <SeparatorMenuItem mnemonicParsing="false" />
                  <MenuItem mnemonicParsing="false" onAction="#closeAdminReadManagerAccount" text="Close" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Edit">
               <items>
                  <MenuItem mnemonicParsing="false" text="Delete" />
               </items>
            </Menu>
            <Menu mnemonicParsing="false" text="Help">
               <items>
                  <MenuItem mnemonicParsing="false" onAction="#helpForReadManagerInformation" text="About read manager information" />
               </items>
            </Menu>
         </menus>
      </MenuBar>
      <TextField fx:id="managerIdForSearch" layoutX="240.0" layoutY="408.0" prefHeight="37.0" prefWidth="504.0" promptText="Manager ID">
         <effect>
            <DropShadow>
               <color>
                  <Color red="0.9578947424888611" green="0.9330604076385498" blue="0.9330604076385498" />
               </color>
            </DropShadow>
         </effect>
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </TextField>
      <Label id="readManagerInformationEnterManagerAccountId" layoutX="423.0" layoutY="371.0" text="Enter Manager Account Id" />
   </children>
</AnchorPane>
